{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "client_type": {
      "type": "string",
      "enum": [
        "Client",
        "In-house"
      ],
      "default": "Client"
    },
    "client_name": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "full_description": {
      "type": "string"
    },
    "services_provided": {
      "type": "string"
    },
    "credits": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "hero_media": {
      "type": "string"
    },
    "gallery_images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "seo_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "social_image": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}