{
  "name": "PhotographyEvent",
  "type": "object",
  "properties": {
    "event_title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "full_description": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "cover_alt": {
      "type": "string"
    },
    "pixieset_url": {
      "type": "string"
    },
    "gallery_button_text": {
      "type": "string",
      "default": "VIEW PHOTOGRAPHY GALLERY"
    },
    "seo_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "social_image": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_title",
    "slug"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}